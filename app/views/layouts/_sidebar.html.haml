%aside.w-64.h-full.fixed.top-0.left-0.bg-gray-800.text-white.p-4.z-10
  %h2.text-xl.font-bold.mb-6.text-center
    = link_to "Nacha Web", root_path, class: "text-white hover:text-gray-200"
  %nav
    %ul.space-y-2
      %li
        = link_to "Dashboard", root_path, class: "flex items-center p-2 text-base font-normal text-gray-100 rounded-lg hover:bg-gray-700"
      %li
        = link_to "API Keys", api_keys_path, class: "flex items-center p-2 text-base font-normal text-gray-100 rounded-lg hover:bg-gray-700"
      %li
        = link_to "Parse ACH File", new_ach_file_path, class: "flex items-center p-2 text-base font-normal text-gray-100 rounded-lg hover:bg-gray-700"
