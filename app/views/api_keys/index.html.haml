- content_for :title, "API Keys"

%h1.text-3xl.font-bold API Keys

- if notice
  .p-4.mb-4.text-sm.text-green-800.rounded-lg.bg-green-50{role: "alert"}
    = notice

- if flash[:token]
  .p-4.mb-4.text-sm.text-blue-800.rounded-lg.bg-blue-50{role: "alert"}
    %span.font-medium Your new API Key (save this somewhere safe, you won't see it again):
    %pre.font-mono.bg-gray-200.p-2.rounded.mt-2.overflow-x-auto
      %code= flash[:token]

.my-4
  = link_to "Create New API Key", new_api_key_path, class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded"

.mt-8
  %h2.text-xl.font-bold Your Keys
  - if @api_keys.any?
    %table.min-w-full.divide-y.divide-gray-200.mt-4
      %thead.bg-gray-50
        %tr
          %th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Description
          %th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Created
          %th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Last Used
          %th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Expires
          %th.relative.px-6.py-3
            %span.sr-only Actions
      %tbody.bg-white.divide-y.divide-gray-200
        - @api_keys.each do |api_key|
          %tr
            %td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-900= api_key.description
            %td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500= time_ago_in_words(api_key.created_at) + " ago"
            %td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500= api_key.last_used_at ? time_ago_in_words(api_key.last_used_at) + " ago" : "Never"
            %td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500= api_key.expires_at ? l(api_key.expires_at, format: :short) : "Never"
            %td.px-6.py-4.whitespace-nowrap.text-right.text-sm.font-medium
              = link_to "Revoke", api_key_path(api_key), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to revoke this key? This cannot be undone." }, class: "text-red-600 hover:text-red-900"
  - else
    .mt-4.text-gray-500 You don't have any API keys yet.
