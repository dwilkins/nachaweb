= form_with model: api_key, class: "mt-4" do |form|
  - if form.object.errors.any?
    .text-red-700
      %h2= "#{pluralize(form.object.errors.count, "error")} prohibited this API key from being saved:"
      %ul
        - form.object.errors.full_messages.each do |message|
          %li= message

  .my-4
    = form.label :description, class: "block text-sm font-medium text-gray-700"
    = form.text_field :description, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"

  .my-4
    = form.label :expires_at, "Expiration Date (optional)", class: "block text-sm font-medium text-gray-700"
    = form.date_field :expires_at, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"

  .my-4
    = form.submit "Create Key", class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded cursor-pointer"
