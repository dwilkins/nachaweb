%h1 Parse ACH File

= form_with(model: @ach_file, url: ach_files_path, local: true) do |form|
  .mb-4
    = form.label :file_data, "Upload File", class: "block text-gray-700 text-sm font-bold mb-2"
    = form.file_field :file_data, class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"

  .mb-4
    = form.label :pasted_text, "Or Paste Text", class: "block text-gray-700 text-sm font-bold mb-2"
    = form.text_area :pasted_text, class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline", rows: 10

  .mb-4
    = form.label :url, "Or Provide URL", class: "block text-gray-700 text-sm font-bold mb-2"
    = form.url_field :url, class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"

  .flex.items-center.justify-between
    = form.submit "Parse File", class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline"
